<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);new</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>$(DefineConstants);new</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Images\Logo.ico" />
    <EmbeddedResource Include="Images\SplashScreen.png" />
    <Content Include="Logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\DockPanel.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeifenLuo.Docking\WeifenLuo.Docking.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="AboutDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ThemeDoc.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="DummyOutputWindow.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="DummyPropertyWindow.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="DummySolutionExplorer.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="DummyTaskList.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="DummyToolbox.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="SplashScreen.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ToolWindow.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="AboutDialog.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="ThemeDoc.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="DummyOutputWindow.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="DummyPropertyWindow.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="DummySolutionExplorer.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="DummyTaskList.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="DummyToolbox.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="MainForm.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="ToolWindow.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="license.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>